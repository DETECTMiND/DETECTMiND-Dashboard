# Copy to .env.local for local development. Never commit real values.
# Supabase project: Settings -> API

# Public (shipped to the browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. Used by the admin API routes (invite / deactivate researchers).
# Bypasses RLS: never prefix it with NEXT_PUBLIC_, never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
